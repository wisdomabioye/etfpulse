# ETFPulse backend environment variables.
#
# Copy this to `.env` (gitignored) and fill in real values. Pydantic-settings
# loads from .env automatically when the process starts in this directory.
#
# Sections below map 1:1 to Coolify env-var config — everything under
# [REQUIRED] must be set in prod, [RECOMMENDED] should be, [OPTIONAL] has
# sane defaults, [PHASE 3] gates SoDEX execution, [DEV-ONLY] stays out of
# prod entirely.
#
# Drift check: the test `tests/test_tools/test_env_drift.py` pins this file
# against `etfpulse.config.Settings`. If you add a new setting in config.py,
# also document it here — the CI check will flag any miss.

# =============================================================================
# [REQUIRED] — prod deploy fails without these
# =============================================================================

# Coolify-managed Postgres injects this automatically when you attach a DB
# service — verify the var name is `DATABASE_URL`. `env.py` normalises both
# `postgres://` (Heroku-style) and `postgresql://` (no driver) into the
# `postgresql+asyncpg://` form we need.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/etfpulse

# Flips logs to JSON, disables SQLAlchemy `echo`, and gates the env-var
# preflight policy (api/config_check.py). Set to `production` in prod.
APP_ENV=development

# SoSoValue API key. Get one at openapi.sosovalue.com.
SOSOVALUE_API_KEY=SOSO-your_key_here


# =============================================================================
# [REQUIRED for product features] — adapters/bot/AI/auth won't function
# =============================================================================

# OpenRouter (LLM gateway for AI signal analysis in Stage 04). Empty in prod
# is a config_check WARNING, not an error — signals persist with NULL
# `ai_analysis` and Branch 6 (AI_BACKFILL_ENABLED) retries them on the
# intra-day cycle. UX degrades; backend doesn't crash.
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Telegram bot (Stage 05). The bot is fully disabled (no webhook registered,
# no route accepts traffic) unless ALL FOUR telegram fields below are set.
TELEGRAM_BOT_TOKEN=123456:your_token_here

# Public base URL Telegram POSTs webhook updates to. MUST be HTTPS — Telegram
# rejects http:// webhook URLs. In prod this is the Coolify-assigned domain.
TELEGRAM_PUBLIC_URL=https://your-app.example.com

# Random URL-safe suffix — primary unguessability defense. The full webhook
# path becomes /api/telegram/webhook/{suffix}. Generate: `openssl rand -base64 24`
TELEGRAM_WEBHOOK_URL_SUFFIX=

# Random secret token Telegram echoes in `X-Telegram-Bot-Api-Secret-Token`
# on every webhook POST. Defense-in-depth against URL leakage from logs/ops.
# Generate: `openssl rand -hex 32`. Rotate via POST /api/admin/telegram/rotate-webhook-secret.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated list of allowed frontend origins for CORS. The default
# covers only local Vite dev; SET THIS in prod or the frontend can't call you.
CORS_ORIGINS=http://localhost:5173

# Public-facing SPA origin — used to build "View on web" inline-keyboard
# deep links on Telegram signal alerts (PR H.2) AND drives the SIWE
# `domain` field shown to wallets (PR D.4.2 — `settings.siwe_domain` is
# derived from this). Empty (default) means: alert keyboard is suppressed
# AND SIWE wallet binding refuses to operate. `api/config_check.py`
# hard-errors when this is empty in production (post-H.2 the keyboard
# carries reasoning/regime/news — without it, recipients lose access to
# the full analysis), warns when localhost-ish.
FRONTEND_URL=http://localhost:5173

# PR D.4 — HS256 signing key for JWT auth (executes / wallet / WebApp).
# Audience `execution`, default TTL 24h. Empty in DEV → ephemeral
# per-process secret + one-time warning; tokens invalidate on every
# restart. Empty in PROD → `api/config_check.py` raises a warning;
# every active session dies on container restart (silently — until users
# notice they're logged out). Generate: `openssl rand -hex 32`.
# Rotation: change value + restart; all existing tokens immediately
# rejected (no graceful rotation in V1 — the SIWE / WebApp paths
# re-mint on next sign-in).
JWT_SECRET=


# =============================================================================
# [RECOMMENDED for security] — safe defaults, should be set explicitly
# =============================================================================

# Admin endpoint gate (`X-Admin-Key` header). When empty (default), every
# `/api/admin/*` route returns 503 — admin surface effectively disabled.
# Generate: `openssl rand -hex 32`.
ADMIN_API_KEY=

# Log verbosity. INFO for normal ops, WARNING if logs get noisy, DEBUG only
# when actively debugging.
LOG_LEVEL=WARNING


# =============================================================================
# [OPTIONAL — app behaviour] — sensible defaults; override only if needed
# =============================================================================

# SoSoValue base URL — override only if using a staging/mock endpoint.
# SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# Fixture mode — when `true`, the SoSoValue adapter reads backend/fixtures/*.json
# instead of hitting the network. Handy for offline demos; tests force this on.
# SOSOVALUE_USE_FIXTURES=false

# Binance public market-data mirror — `data-api.binance.vision` avoids
# geo-blocks that hit `api.binance.com` from some hosts. Fixture mode
# is for offline test work, same shape as SOSOVALUE_USE_FIXTURES.
# BINANCE_BASE_URL=https://data-api.binance.vision
# BINANCE_USE_FIXTURES=false

# Process flags — set one to `false` if splitting bot/scheduler into a
# dedicated worker process. Single-process deploy leaves both on.
# RUN_BOT=true
# RUN_SCHEDULER=true

# Uvicorn bind — the Dockerfile CMD overrides these, so setting here only
# matters for direct `uvicorn` invocations.
# API_HOST=0.0.0.0
# API_PORT=8000

# Daily signal-cycle cron (always UTC — the scheduler pins timezone="UTC"
# regardless of host clock). Defaults fire at 04:30 UTC, ~30 min after
# SoSoValue's nightly settlement window.
# SCHEDULER_CRON_HOUR=4
# SCHEDULER_CRON_MINUTE=30

# Branch 3 — intra-day re-ingest + re-detect interval. The daily cron above
# fires once at HH:MM UTC, so ETF data or news that lands AFTER the cron
# is invisible until the next day. This interval runs the same cycle on
# the configured cadence with a skip-guard that short-circuits ticks where
# no new ETF / news rows arrived — most ticks are cheap no-ops; only the
# ones that see new SoSoValue data run detectors and AI. 0 disables the
# intra-day cycle entirely (falls back to daily-cron-only behaviour).
# Valid range: 0 OR 15-360 minutes. Sub-15-min configs risk burning the
# SoSoValue monthly quota.
# INTRADAY_CYCLE_INTERVAL_MINUTES=60

# OpenRouter tuning. Model slug must exist on openrouter.ai/api/v1/models —
# a typo 404s every AI call. Daily cap is UTC-anchored; 0 disables.
# Max tokens lower bound 256 — below this risks JSON truncation.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_DAILY_CALL_CAP=100
# OPENROUTER_MAX_TOKENS=1024

# OpenRouter identifying headers (sent on every call for dashboard
# attribution). Override per-environment for prod vs preview.
# OPENROUTER_APP_URL=https://etfpulse.xpldevelopers.org
# OPENROUTER_APP_TITLE=ETFPulse

# Branch 6 — NULL-confidence auto-retry. When OpenRouter fails at signal-
# build time, the signal persists with `ai_analysis IS NULL` and is
# invisible to fan-out, outcome eval, and the reaper. Branch 6 calls the
# existing `backfill_null_ai` helper on every intra-day cycle tick so
# transient outages self-heal. AI_BACKFILL_ENABLED=false disables the
# auto-path while keeping the manual `POST /api/admin/signals/retry-ai`
# endpoint. LIMIT bounds OpenRouter spend per tick (5 retries × hourly =
# up to 120/day, within the 100 default OPENROUTER_DAILY_CALL_CAP — raise
# the cap if both paths run hot). MAX_AGE_HOURS skips stale market data;
# 0 means "retry any age" (operators draining a backlog use the manual
# endpoint which ignores this filter).
# AI_BACKFILL_ENABLED=true
# AI_BACKFILL_LIMIT_PER_TICK=5
# AI_BACKFILL_MAX_AGE_HOURS=24

# Admin alert threshold for `signals_null_confidence`. When the count
# exceeds this, `GET /api/admin/metrics.signals_null_confidence_alert`
# flips True so dashboards can color the counter red / page ops. Default
# 50 = "background failure rate no longer looks transient".
# SIGNALS_NULL_CONFIDENCE_ALERT_THRESHOLD=50

# Stage 05 delivery worker — drains queued SignalDelivery rows on this interval.
# Default 30s is well under any signal's swing/scalp half-life.
# DELIVERY_WORKER_INTERVAL_SECONDS=30

# Stage 08 outcome evaluator — scores aged signals (>=72h old) against daily
# OHLC bars to populate SignalOutcome rows. Default 1h since outcomes only
# change once per day when new daily bars become available.
# OUTCOME_EVAL_INTERVAL_SECONDS=3600
# Per-tick batch cap. Each candidate triggers one upstream klines fetch
# (SoSoValue ~100 req/min cap), so an uncapped tick on a fresh deploy
# with a stranded backlog of 200+ signals would risk tripping the rate
# limit. Default 50 leaves headroom; lower for very-low-quota environments.
# Bounds: [1, 500].
# OUTCOME_EVAL_BATCH_LIMIT=50

# Reapers (issues #30 + #36). Both run on intervals — neither is
# latency-sensitive. 15 min default is well under any plausible
# signal half-life. 60s floor protects against test misconfig.
# SIGNAL_EXPIRY_REAPER_INTERVAL_SECONDS=900
# DELIVERY_REAPER_INTERVAL_SECONDS=900

# A SignalDelivery in PENDING longer than this is "stuck" — the delivery
# reaper flips it to FAILED with a sentinel error_message. Default 600s
# ≈ 20 send-worker ticks at the 30s default. Branch 2 narrows the reaper's
# WHERE clause to `last_attempt_at IS NULL` so retrying rows are not
# touched — this knob now only catches rows the worker never picked up.
# DELIVERY_PENDING_MAX_AGE_SECONDS=600

# Branch 2 — retry policy for TRANSIENT Telegram errors (rate-limit,
# 5xx, network). Terminal errors (blocked, chat-not-found, migrated)
# remain single-attempt with target-side remediation.
#
# Total attempts = DELIVERY_MAX_ATTEMPTS (5 = first try + 4 retries).
# Backoff per attempt = DELIVERY_RETRY_BASE_SECONDS * 2^(attempt - 1).
# Defaults: 30, 60, 120, 240s between attempts → ~7.5 min worst case.
# DELIVERY_MAX_ATTEMPTS=5
# DELIVERY_RETRY_BASE_SECONDS=30

# Bounded wait at scheduler shutdown (issue #28). Gives in-flight jobs a
# chance to finish before SIGTERM cancels them. 0 disables.
# SCHEDULER_SHUTDOWN_GRACE_SECONDS=10

# Default user preferences applied on /start registration. Users override per-
# subscription via /prefs commands.
# DELIVERY_DEFAULT_MIN_CONFIDENCE=6
# DELIVERY_DEFAULT_ASSETS=BTC,ETH

# #184 — default value of `User.paper_trade` applied at user-creation. True
# is the safe-by-default posture for mainnet deploys: a fresh user with
# `wallet_address` bound + an API key registered won't accidentally place
# a real-money order — the execution path short-circuits to a simulated
# fill until an operator flips them off paper-trade via
# `POST /api/admin/users/{id}/paper-trade`. Set False on a testnet-only
# deploy if you want fresh users live-trading testnet immediately (still
# safe because testnet funds aren't real).
# USER_PAPER_TRADE_DEFAULT=true

# #185 — Telegram chat id that receives "request live trading" notifications
# from paper-trade users (`POST /api/wallet/request-live`). 0 = disabled
# (the route returns 503 with a clear detail so users see "feature not
# configured" instead of failing silently). Typical setup: create a
# private Telegram group, add the bot, find the group id via Telegram's
# getUpdates API after a test message, paste here. Negative integers are
# valid for supergroups.
# OPERATOR_TELEGRAM_CHAT_ID=0

# Per-user cooldown on request-live submissions (seconds). Default 1h —
# prevents a user from spamming the operator chat without blocking a
# legitimate "I forgot to mention X" retry. In-memory cache; resets on
# container restart (operator may see duplicates within a window across
# restarts — acceptable since the message content is identical).
# REQUEST_LIVE_COOLDOWN_SECONDS=3600


# =============================================================================
# [OPTIONAL — detector thresholds] — issue #33
# =============================================================================
# Tune detection sensitivity without redeploying code. Defaults match the
# values pinned in `pipeline/detectors/*` at Stage 04 — change behaviour by
# setting env vars, not by editing detector code.

# FLOW_ANOMALY_LOOKBACK_DAYS=14
# FLOW_ANOMALY_MIN_STREAK_LENGTH=3
# MAGNITUDE_LOOKBACK_DAYS=90
# MAGNITUDE_PERCENTILE_THRESHOLD=0.80
# MAGNITUDE_MIN_HISTORY_DAYS=30

# Acceleration — PR F.1 redesigned to second-derivative (3 × N-day windows).
# Threshold default raised from 0.50 → 1.00; second derivatives are more
# volatile than first.
# ACCELERATION_WINDOW=7
# ACCELERATION_CHANGE_THRESHOLD=1.00

# Floor on |slope_old| (the prior→mid window-sum delta) to avoid huge
# ratios from near-zero baseline slopes. USD. PR F.1 renamed from
# ACCELERATION_MIN_PRIOR_USD — the old name still works via AliasChoices
# for backward-compat (config_check warns when only the old name is set),
# but new deploys should use the new name.
# ACCELERATION_MIN_SLOPE_OLD_USD=1000000

# Divergence — PR F.2 added magnitude floors. Detector requires BOTH a
# meaningful price move AND meaningful flow volume over the window before
# firing on sign-mismatch.
# DIVERGENCE_LOOKBACK_DAYS=3
# DIVERGENCE_MIN_PRICE_CHANGE_PCT=0.02
# DIVERGENCE_MIN_FLOW_SUM_USD=300000000


# =============================================================================
# [OPTIONAL — predictive robustness (I.1–I.4)] — track-record analytics
# =============================================================================
# These knobs tune the public track-record surfaces (calibration curve,
# per-detector leaderboard, MARKET composite scoring) and the confirmation-
# score delivery gate.

# PR I.1 — confidence calibration (on-read reliability curve). Aggregation
# is cached per `(ai_prompt_version, lookback_days, bucket_size, min_samples)`
# tuple for `cache_ttl_seconds`. Bucket size MUST divide 10 evenly ({1,2,5,10}).
# CALIBRATION_LOOKBACK_DAYS=90
# CALIBRATION_MIN_SAMPLES_PER_BUCKET=20
# CALIBRATION_BUCKET_SIZE=2
# CALIBRATION_CACHE_TTL_SECONDS=300

# PR I.2 — multi-factor confirmation gate. Signals score 0..3 across price /
# regime / news factors (news always 0 in v1). NULL scores pass the gate
# (AI-failed / wait / pre-I.2 legacy / MARKET). Set 0 to disable the gate
# entirely. Price-factor window + min-pct shape what counts as "moved".
# DELIVERY_MIN_CONFIRMATION=1
# FACTOR_PRICE_WINDOW_HOURS=24
# FACTOR_PRICE_MIN_PCT=0.01

# PR I.3 — per-detector precision leaderboard. Min-samples gate; below this,
# cells render as "—" instead of noisy point estimates. Lower than
# calibration's min_samples (3 vs 20) because per-detector cells have
# different sample-density characteristics.
# PER_DETECTOR_MIN_SAMPLES=3

# PR I.3b — MARKET composite scoring for regime_shift (asset=MARKET) signals.
# Weights MUST sum to exactly 1.0 (boot-time `model_validator` enforces this
# with 1e-9 tolerance). Hit threshold is the absolute |composite_return|
# required in the AI's direction for hit_target=True. Default 2% ≈ one
# daily stdev for combined BTC+ETH.
# MARKET_COMPOSITE_WEIGHT_BTC=0.5
# MARKET_COMPOSITE_WEIGHT_ETH=0.5
# MARKET_COMPOSITE_HIT_PCT=0.02

# PR I.4 — regime-conditional magnitude thresholds. Multiplier applied to
# `magnitude_percentile_threshold` based on the current MarketRegime.
# Defaults 1.0 → ZERO behavior change. Tuning these requires backtest
# evidence (PR I.5 harness). UNCERTAIN regime has no var — always uses
# base. Effective threshold clamped to (0.01, 0.99); clamp event logged.
# REGIME_MULT_MAGNITUDE_PCTILE_MARKUP=1.0
# REGIME_MULT_MAGNITUDE_PCTILE_MARKDOWN=1.0
# REGIME_MULT_MAGNITUDE_PCTILE_ACCUMULATION=1.0
# REGIME_MULT_MAGNITUDE_PCTILE_DISTRIBUTION=1.0


# =============================================================================
# [PHASE 3] — SoDEX execution (Stage 09 / PRs D.1–D.5)
# =============================================================================
# No SoDEX-key env vars exist by design. The production backend never holds,
# generates, or signs with private keys. SoDEX execution flows go through
# wallet-side signing only (wagmi/viem + WalletConnect in the frontend);
# the backend only builds EIP-712 typed-data and submits already-signed
# payloads. See CLAUDE.md "Conventions to respect" + scripts/sodex_verify/
# (operator-only verification tooling, never imported by etfpulse/*).

# ----- D.2: SoDEX HTTP adapter (testnet / mainnet) -----
# Environment switches base URLs + chainId. Safe-by-default: a deploy that
# forgets to set this doesn't accidentally hit mainnet. Chain IDs verified
# via V.3 capture (testnet=138565); mainnet=286623 per api.md, confirmed
# only after testnet smoke passes.
# SODEX_ENVIRONMENT=testnet
# SODEX_TESTNET_CHAIN_ID=138565
# SODEX_MAINNET_CHAIN_ID=286623

# Override the env-derived URLs only for mock-gateway tests or a self-hosted
# gateway. Empty = derive from SODEX_ENVIRONMENT.
# SODEX_SPOT_BASE_URL=
# SODEX_PERPS_BASE_URL=

# HTTP tunables. Timeout covers V.2's 95%ile latencies (~2s observed).
# Retry policy: 429 + 5xx + network only — envelope errors NEVER retry
# (they're deterministic, retrying burns rate-limit budget). Linear
# backoff: `base * 2^(N-1)` seconds per attempt.
# SODEX_HTTP_TIMEOUT_SECONDS=10.0
# SODEX_HTTP_RETRY_MAX_ATTEMPTS=3
# SODEX_HTTP_RETRY_BASE_SECONDS=1.0

# ----- D.3: execution surface — risk caps + lifecycle cadences -----
# Risk caps. `daily_notional_usd_cap` carries the dev default of $10k by
# design — `config_check.py` warns when prod still has this value so an
# operator notices before live traffic. `per_symbol` MUST be <= `daily`;
# boot-time validator refuses to start otherwise. `max_leverage` 1..20
# (SoDEX testnet ceiling); preflight warns above 10 (retail-prudent line).
# Paper slippage in bps: simulated fill price = spot ± bps in AI direction.
# EXECUTION_MAX_OPEN_ORDERS_PER_USER=5
# EXECUTION_DAILY_NOTIONAL_USD_CAP=10000
# EXECUTION_PER_SYMBOL_NOTIONAL_USD_CAP=5000
# EXECUTION_MAX_LEVERAGE=5
# EXECUTION_PAPER_SLIPPAGE_BPS=5

# Reaper + reconcile cadences. All seconds. 60s floor mirrors the existing
# reaper convention. `min_age=0` is meaningful (force-reconcile immediately).
# Orphan grace: drift logged when missing on venue past this age.
# ORDER_EXPIRY_REAPER_INTERVAL_SECONDS=900
# ORDER_RECONCILE_INTERVAL_SECONDS=60
# ORDER_RECONCILE_MIN_AGE_SECONDS=60
# ORDER_RECONCILE_ORPHAN_GRACE_SECONDS=300

# Daily symbol-refresh cron (cached `sodex_symbols` table). UTC.
# Default 04:00 fires before the main daily cycle (04:30) so symbol_id
# resolution is fresh by the time signal-driven orders need it.
# SYMBOLS_REFRESH_CRON_HOUR=4
# SYMBOLS_REFRESH_CRON_MINUTE=0

# ----- D.4 / D.5: auth foundation (JWT + SIWE + Telegram WebApp) -----
# JWT_SECRET itself is in [REQUIRED] above. TTL is the lifetime of a freshly
# minted token; 24h is the V1 default — long enough for demo sessions, short
# enough that a leaked token has bounded blast radius. No refresh tokens in
# V1 (re-mint by re-doing SIWE or re-launching the WebApp).
# JWT_TTL_SECONDS=86400

# SIWE nonce TTL — single-use AND time-bounded. 10min generous enough for
# users to read the wallet prompt, tight enough that intercepted nonces
# have bounded replay window.
# WALLET_NONCE_TTL_SECONDS=600

# Human-readable text shown in the wallet's signing prompt. A distinctive
# statement helps users spot phishing ("Sign in to ETFPulse" on a
# not-ETFPulse site is suspicious). The verifier doesn't enforce exact
# match — the FE always sends this exact text via the /nonce response.
# SIWE_STATEMENT="Sign in to ETFPulse to manage your trading account."

# Telegram WebApp initData freshness window (PR D.5.1). An initData payload
# signed by Telegram more than this many seconds ago is rejected. 10min
# is generous enough to open the WebApp + load the SPA, tight enough that
# a captured initData can't be replayed later.
# WEBAPP_INIT_DATA_MAX_AGE_SECONDS=600

# #78.9 — shorter JWT TTL for WebApp-minted tokens. SIWE path keeps the
# default JWT_TTL_SECONDS (24h) because a fresh SIWE prompt is a heavy
# ask; WebApp re-launch is cheap (tap `/execute` reply's button), so a
# tighter blast-radius is appropriate. 1h is the V1 default; range
# matches JWT_TTL_SECONDS (60s..30d).
# WEBAPP_JWT_TTL_SECONDS=3600


# =============================================================================
# [DEV-ONLY] — never set in prod
# =============================================================================

# Test DB, pytest-only. Migrations for this DB are managed by tests/conftest.py.
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/etfpulse_test
