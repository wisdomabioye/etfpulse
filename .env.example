# SoSoValue
SOSOVALUE_API_KEY=SOSO-your_key_here
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1
# Set true to read backend/fixtures/*.json instead of hitting the real API.
SOSOVALUE_USE_FIXTURES=false

# SoDEX (Wave 3)
SODEX_WALLET_ADDRESS=0x_your_address
SODEX_PRIVATE_KEY=your_private_key
SODEX_ACCOUNT_ID=0

# OpenRouter (AI)
OPENROUTER_API_KEY=your_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# App
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/etfpulse
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/etfpulse_test
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Frontend (set in Vercel or .env.local)
VITE_API_BASE_URL=http://localhost:8000
