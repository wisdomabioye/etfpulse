# Frontend environment — copy to `.env.local` (gitignored via *.local) to
# override per-developer, or leave everything commented for standard dev.
#
# Vite rule: only `VITE_*` vars are exposed to browser code. Anything else
# stays server-side and won't show up in `import.meta.env`.

# Base URL the SPA prefixes onto every `/api/...` request. See src/api/client.ts.
#
# - Dev (default):   leave UNSET. fetch uses relative `/api/...` → the Vite
#                    dev server proxies to http://localhost:8000 (vite.config.ts).
#                    No CORS friction.
# - Prod (Vercel):   set to the absolute Coolify backend URL, e.g.
#                    https://etfpulse-api.example.com
#                    Coolify's CORS_ORIGINS must include the Vercel origin.
#
# NO trailing slash — client.ts appends the path directly.
#VITE_API_BASE_URL=https://etfpulse-api.example.com
