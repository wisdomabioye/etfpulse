# Frontend environment — copy to `.env.local` (gitignored via *.local) to
# override per-developer, or leave everything commented for standard dev.
#
# Vite rule: only `VITE_*` vars are exposed to browser code. Anything else
# stays server-side and won't show up in `import.meta.env`.

# Base URL the SPA prefixes onto every `/api/...` request. See src/api/client.ts.
#
# - Dev (default):   leave UNSET. fetch uses relative `/api/...` → the Vite
#                    dev server proxies to http://localhost:8000 (vite.config.ts).
#                    No CORS friction.
# - Prod (Vercel):   set to the absolute backend URL, e.g.
#                    https://etfpulse-api.example.com
#                    The backend's CORS_ORIGINS must include the Vercel origin.
#
# NO trailing slash — client.ts appends the path directly.
#VITE_API_BASE_URL=https://etfpulse-api.example.com


# ---------------------------------------------------------------------------
# PR D.4.4 — SoDEX wallet integration (Execute page)
# ---------------------------------------------------------------------------

# Reown (WalletConnect v2) project ID. Get one free at https://cloud.reown.com.
#
# When unset:
#   - AppKit is NOT initialised (no console warning every page load).
#   - `isWalletConnectAvailable` is false → the Connect button on the
#     Execute page renders as disabled with a tooltip.
#   - Everything else in the app keeps working.
#
# Required for ANY wallet connect flow to function (dev or prod).
#VITE_WALLETCONNECT_PROJECT_ID=

# Active SoDEX chain ID. Must match `settings.sodex_chain_id` on the
# backend (driven by SODEX_ENVIRONMENT env). Mismatch = every SIWE
# verify rejects with "chain_id mismatch".
#
#   138565 = SoDEX testnet (default)
#   286623 = SoDEX mainnet
#
# Leave unset to default to testnet. Setting this is REQUIRED in prod
# alongside `SODEX_ENVIRONMENT=mainnet` on the backend.
#VITE_SODEX_CHAIN_ID=138565
