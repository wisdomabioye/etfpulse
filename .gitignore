# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
*.db
*.sqlite3
data/

# Tool caches (each cache directory also self-ignores via its own inner
# .gitignore, but we list them here so intent is explicit and future tools
# that don't self-ignore still get caught.)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.backtest_cache/

# Node
node_modules/
frontend/dist/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
